@model List<Cliente>

@{
    ViewData["Title"] = "Gestión de clientes";
}

<script src="https://cdn.jsdelivr.net/npm/%40tailwindcss/browser@4"></script>

<div class="min-h-screen bg-slate-50 px-4 py-8 sm:px-8">
    <div class="mx-auto max-w-7xl">

        <!-- Encabezado -->
        <div class="mb-8 overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 to-blue-900 p-8 text-white shadow-lg">
            <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-widest text-blue-300">
                        Panel de administración
                    </p>

                    <h1 class="mt-3 text-3xl font-extrabold sm:text-4xl">
                        Gestión de clientes
                    </h1>

                    <p class="mt-3 max-w-xl text-slate-300">
                        Consulta y administra la información de tus clientes
                        desde un solo lugar.
                    </p>
                </div>

                <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-3xl">
                    👥
                </div>
            </div>
        </div>

        <!-- Mensaje de error -->
        @if (ViewBag.Error != null)
        {
            <div class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-700"
                 role="alert">
                <span class="font-bold">Atención:</span>
                @ViewBag.Error
            </div>
        }

        <!-- Tarjetas de información -->
        <div class="mb-8 grid gap-5 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Total de clientes
                        </p>

                        <p class="mt-2 text-3xl font-extrabold text-slate-900">
                            @Model.Count
                        </p>

                        <p class="mt-2 text-sm text-slate-500">
                            Registros disponibles
                        </p>
                    </div>

                    <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-blue-100 text-2xl">
                        👤
                    </div>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Estado del listado
                        </p>

                        <p class="mt-2 text-2xl font-bold text-emerald-700">
                            Disponible
                        </p>

                        <p class="mt-2 text-sm text-slate-500">
                            Consulta de clientes
                        </p>
                    </div>

                    <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-emerald-100 text-2xl">
                        ✓
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de clientes -->
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

            <div class="flex flex-col justify-between gap-3 border-b border-slate-200 p-6 sm:flex-row sm:items-center">
                <div>
                    <h2 class="text-xl font-bold text-slate-900">
                        Listado de clientes
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Información registrada en el sistema.
                    </p>
                </div>

                <span class="w-fit rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700">
                    @Model.Count registros
                </span>
            </div>

            @if (Model.Count == 0)
            {
                <div class="px-6 py-16 text-center">
                    <div class="text-5xl">📋</div>

                    <h3 class="mt-4 text-lg font-bold text-slate-900">
                        No hay clientes registrados
                    </h3>

                    <p class="mt-2 text-sm text-slate-500">
                        Cuando haya clientes disponibles, aparecerán en esta tabla.
                    </p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                            <tr>
                                <th scope="col" class="px-6 py-4 font-bold">
                                    ID
                                </th>
                                <th scope="col" class="px-6 py-4 font-bold">
                                    Nombre
                                </th>
                                <th scope="col" class="px-6 py-4 font-bold">
                                    Teléfono
                                </th>
                                <th scope="col" class="px-6 py-4 font-bold">
                                    Ciudad
                                </th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-100">
                            @foreach (Cliente c in Model)
                            {
                                <tr class="transition hover:bg-blue-50/50">
                                    <td class="whitespace-nowrap px-6 py-5 font-semibold text-slate-500">
                                        #@c.Id
                                    </td>

                                    <td class="whitespace-nowrap px-6 py-5">
                                        <div class="flex items-center gap-3">
                                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-100 font-bold text-blue-800">
                                                @(string.IsNullOrWhiteSpace(c.Nombre) ? "?" : c.Nombre.Substring(0, 1).ToUpperInvariant())
                                            </div>

                                            <span class="font-semibold text-slate-900">
                                                @c.Nombre
                                            </span>
                                        </div>
                                    </td>

                                    <td class="whitespace-nowrap px-6 py-5 text-slate-600">
                                        <span class="mr-2">☎</span>@c.Telefono
                                    </td>

                                    <td class="whitespace-nowrap px-6 py-5">
                                        <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1.5 font-medium text-slate-700">
                                            📍 @c.Ciudad
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Pie de tabla -->
            <div class="border-t border-slate-200 bg-slate-50 px-6 py-4">
                <p class="text-sm text-slate-500">
                    Total de clientes:
                    <strong class="text-slate-900">@Model.Count</strong>
                </p>
            </div>
        </div>

        <!-- Regresar al inicio -->
        <div class="mt-6">
            <a asp-controller="Home"
               asp-action="Index"
               class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:bg-slate-100">
                <span aria-hidden="true">←</span>
                Volver al inicio
            </a>
        </div>

    </div>
</div>