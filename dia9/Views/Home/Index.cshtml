 @{
    ViewData["Title"] = "Inicio";
}

<script src="https://cdn.jsdelivr.net/npm/%40tailwindcss/browser@4"></script>

<div class="min-h-screen bg-slate-50">
    <!-- Encabezado principal -->
    <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-900 px-6 py-20 text-white sm:py-28">
        <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-blue-500/20 blur-3xl"></div>
        <div class="absolute -bottom-24 -left-16 h-64 w-64 rounded-full bg-indigo-400/20 blur-3xl"></div>

        <div class="relative mx-auto max-w-6xl">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-blue-100">
                <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                Sistema de gestión
            </span>

            <h1 class="mt-6 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-6xl">
                Administra tus clientes
                <span class="text-blue-300">de forma sencilla.</span>
            </h1>

            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
                Organiza la información de tus clientes, consulta sus datos
                y mantén todo bajo control desde un solo lugar.
            </p>

            <div class="mt-9 flex flex-wrap gap-4">
                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="inline-flex items-center gap-2 rounded-xl bg-blue-500 px-6 py-3.5 font-semibold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-400">
                    Ver clientes
                    <span aria-hidden="true">&rarr;</span>
                </a>

                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="inline-flex items-center rounded-xl border border-white/20 px-6 py-3.5 font-semibold text-white transition hover:bg-white/10">
                    Privacidad
                </a>
            </div>
        </div>
    </section>

    <!-- Características -->
    <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <div class="mb-10">
            <p class="text-sm font-bold uppercase tracking-widest text-blue-600">
                Todo más organizado
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">
                Gestiona tu información
            </h2>
            <p class="mt-3 max-w-2xl text-slate-600">
                Accede rápidamente a las herramientas principales de tu sistema.
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-3">
            <!-- Tarjeta 1 -->
            <div class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-2xl">
                    👥
                </div>

                <h3 class="mt-5 text-xl font-bold text-slate-900">
                    Clientes
                </h3>

                <p class="mt-3 leading-7 text-slate-600">
                    Consulta y administra los datos de las personas registradas.
                </p>

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="mt-6 inline-flex items-center gap-2 font-semibold text-blue-700 hover:text-blue-900">
                    Ir a clientes <span aria-hidden="true">&rarr;</span>
                </a>
            </div>

            <!-- Tarjeta 2 -->
            <div class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-2xl">
                    📋
                </div>

                <h3 class="mt-5 text-xl font-bold text-slate-900">
                    Organización
                </h3>

                <p class="mt-3 leading-7 text-slate-600">
                    Mantén la información estructurada y facilita su consulta.
                </p>

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="mt-6 inline-flex items-center gap-2 font-semibold text-emerald-700 hover:text-emerald-900">
                    Consultar registros <span aria-hidden="true">&rarr;</span>
                </a>
            </div>

            <!-- Tarjeta 3 -->
            <div class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-100 text-2xl">
                    🔒
                </div>

                <h3 class="mt-5 text-xl font-bold text-slate-900">
                    Privacidad
                </h3>

                <p class="mt-3 leading-7 text-slate-600">
                    Consulta la información relacionada con la privacidad de la aplicación.
                </p>

                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="mt-6 inline-flex items-center gap-2 font-semibold text-violet-700 hover:text-violet-900">
                    Ver información <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        </div>

        <!-- Pie de bienvenida -->
        <div class="mt-12 flex flex-col justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-6 sm:flex-row sm:items-center sm:p-8">
            <div>
                <h3 class="text-lg font-bold text-slate-900">
                    Tu información, mejor organizada.
                </h3>
                <p class="mt-1 text-sm text-slate-600">
                    Utiliza el menú para acceder a las distintas secciones del sistema.
                </p>
            </div>

            <a asp-controller="Clientes"
               asp-action="Index"
               class="inline-flex shrink-0 items-center justify-center rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white transition hover:bg-slate-700">
                Comenzar
            </a>
        </div>
    </section>
</div>