@model Movimiento
@{
	ViewData["Title"] = "Nuevo movimiento";
}

<h1>Nuevo movimiento</h1>

<form asp-action="Create" method="post">
	<div class="mb-3">
		<label asp-for="Tipo" class="form-label"></label>
		<select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoMovimiento>()" class="form-select"></select>
	</div>
	<div class="mb-3">
		<label asp-for="Monto" class="form label"></label>
		<input asp-for="Monto" class="form-control" />
		<span asp-validation-for="Monto" class="text-danger"></span>
	</div>
</form>